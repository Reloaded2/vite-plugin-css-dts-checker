{
  "name": "vite-plugin-css-dts-checker",
  "version": "0.1.0",
  "description": "Findet ungenutzte CSS/SCSS-Klassen anhand der .d.ts-Dateien (Vite-Port von css-dts-checker-webpack-plugin)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepare": "pnpm run build"
  },
  "author": "Andrej Schneider",
  "license": "MIT",
  "peerDependencies": {
    "typescript": ">=4.9",
    "vite": ">=4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
