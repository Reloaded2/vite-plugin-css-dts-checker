{
  "name": "vite-plugin-css-dts-checker",
  "version": "0.1.0",
  "description": "Findet ungenutzte CSS/SCSS-Klassen anhand der .d.ts-Dateien (Vite-Port von css-dts-checker-webpack-plugin)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build"
  },
  "author": "Andrej Schneider",
  "license": "MIT",
  "peerDependencies": {
    "vite": ">=4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^6.0.2",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2"
  }
}
